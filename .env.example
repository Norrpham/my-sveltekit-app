# Copy this file to .env (which Git ignores) and fill in your own values.
# On Vercel, add the same names under Project Settings > Environment Variables.

# Your OpenRouter API key, from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: which model turns words into a spec (default: openai/gpt-oss-20b)
OPENROUTER_MODEL=
